// @rheged-studio/markdownlint-config
//
// Philosophy: strict on structure (headings, lists, links, tables, fence
// language tags), lenient on prose (line length, inline HTML).
//
// Rationale lives next to each non-default rule — keep them in sync.
// `"default": true` enables every other rule with its stock options;
// only non-default decisions are enumerated below.
//
// Audited 2026-08-04 against markdownlint-cli2 ^0.22.1 (markdownlint 0.40.0).
// Consume via markdownlint-cli2 — its parser stack handles JSONC; bare
// markdownlint with `JSON.parse` will reject the comments.
{
  "default": true,

  // MD003 — ATX-style headings (`# Heading`) only, not Setext (`Heading\n===`).
  // ATX reads better in raw markdown and is easier to manipulate programmatically.
  "MD003": { "style": "atx" },

  // MD004 — Unordered-list bullets use `-` only (matches Prettier). Locks the
  // default "consistent" option to a single canonical style estate-wide.
  "MD004": { "style": "dash" },

  // MD007 — Nested unordered lists indent by 2 spaces. Matches Prettier's default,
  // so `markdownlint --fix` and `prettier --write` don't fight each other.
  "MD007": { "indent": 2 },

  // MD013 — Disabled. Line length is a prose concern; editors handle wrapping.
  // Enforcing a column count creates friction in long URLs, tables, and
  // reference-link definitions without delivering proportional value.
  "MD013": false,

  // MD024 — Allow repeated heading text across non-sibling sections.
  // Changelogs (repeated "### Patch Changes" under each version) and API docs
  // (per-class "## Methods") legitimately reuse headings — only flag duplicates
  // within the same parent.
  "MD024": { "siblings_only": true },

  // MD029 — Ordered-list items numbered sequentially (1. 2. 3.), not all-ones.
  // Sequential numbering reads correctly in raw markdown and in plain-text diffs.
  "MD029": { "style": "ordered" },

  // MD033 — Disabled. MDX routinely embeds JSX/HTML; gating with `allowed_elements`
  // would churn whenever a new component is introduced. Trust the author.
  "MD033": false,

  // MD035 — Thematic breaks are `---` only. Locks the default "consistent"
  // option so `***` / `___` don't drift in.
  "MD035": { "style": "---" },

  // MD040 — Require a language tag on every fenced code block. Pseudo-code,
  // verbatim CLI output, and other language-less samples use `text`, `console`,
  // or `plaintext`. Re-enabled after the Hecate comparison (R-928); previously
  // re-disabled in protomolecule PR #345 over friction with untagged samples.
  "MD040": true,

  // MD041 — Require a first-line H1, or a frontmatter `title:` as an
  // alternative (not itself an H1). Fragments with neither still fail;
  // exclude via consumer `ignores` or disable-next-line. Estate audit:
  // R-1199 (split from R-929).
  "MD041": true,

  // MD044 — Proper-name capitalisation. Conservative list only: short format /
  // tool names (JSON, YAML, npm, ESLint, …) false-positive on filenames and
  // package ids (`package.json`, `eslint-config`). code_blocks off for samples.
  "MD044": {
    "names": [
      "GitHub",
      "JavaScript",
      "TypeScript",
      "Node.js",
      "markdownlint",
      "Linear",
    ],
    "code_blocks": false,
  },

  // MD046 — Code blocks must be fenced (bans indented code blocks).
  "MD046": { "style": "fenced" },

  // MD048 — Fence style is backtick only (bans `~~~`).
  "MD048": { "style": "backtick" },

  // MD049 — Emphasis (italic) uses underscores: `_like this_`. Pairs with
  // MD050 asterisk bold for unambiguous `_italic_` + `**bold**`.
  "MD049": { "style": "underscore" },

  // MD050 — Strong (bold) uses asterisks: `**like this**`.
  "MD050": { "style": "asterisk" },
}
